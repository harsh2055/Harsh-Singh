rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == "harshs288375@gmail.com"; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin() && isValidId(projectId);
    }

    // Skills Collection
    match /skills/{skillId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin() && isValidId(skillId);
    }

    // Messages Collection
    match /messages/{messageId} {
      allow create: if true; // Public can send messages
      allow read, update, delete: if isAdmin();
    }
  }
}
