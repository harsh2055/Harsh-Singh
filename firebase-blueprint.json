{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Details about a specific work project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "githubUrl": { "type": "string" },
        "liveUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["ongoing", "completed"] },
        "progress": { "type": "number" },
        "challenges": { "type": "array", "items": { "type": "string" } },
        "solutions": { "type": "array", "items": { "type": "string" } },
        "learnings": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "status"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical skill with usage and proficiency metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["frontend", "backend", "database", "tools", "ai"] },
        "lastUsed": { "type": "string", "format": "date-time" },
        "projectsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["mastered", "learning"] },
        "learningProgress": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["name", "category", "status"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "A message sent from the contact form.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of all projects (ongoing and completed)."
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Inventory of developer skills and proficiency."
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Submission messages from the contact form."
    }
  }
}
